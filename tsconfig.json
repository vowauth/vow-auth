{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"paths": {
			"@vow-auth/core/testing": ["./packages/core/src/testing.ts"],
			"@vow-auth/core": ["./packages/core/src/index.ts"],
			"@vow-auth/adapter-memory": ["./packages/adapter-memory/src/index.ts"],
			"@vow-auth/adapter-redis": ["./packages/adapter-redis/src/index.ts"],
			"@vow-auth/authorize": ["./packages/authorize/src/index.ts"],
			"@vow-auth/factor-email-link": [
				"./packages/factor-email-link/src/index.ts"
			]
		}
	},
	"include": [
		"vitest.config.ts",
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"examples/*/src/**/*.ts",
		"examples/*/tests/**/*.ts"
	],
	"exclude": ["node_modules", "**/dist"]
}
