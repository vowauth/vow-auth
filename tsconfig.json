{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"paths": {
			"@vow-auth/core/internal": ["./packages/core/src/internal.ts"],
			"@vow-auth/core": ["./packages/core/src/index.ts"],
			"@vow-auth/adapter-memory": ["./packages/adapter-memory/src/index.ts"],
			"@vow-auth/adapter-redis": ["./packages/adapter-redis/src/index.ts"],
			"@vow-auth/doctor": ["./packages/doctor/src/index.ts"],
			"@vow-auth/adapter-postgres": [
				"./packages/adapter-postgres/src/index.ts"
			],
			"@vow-auth/http": ["./packages/http/src/index.ts"],
			"@vow-auth/service": ["./packages/service/src/index.ts"],
			"@vow-auth/test-support": ["./packages/test-support/src/index.ts"],
			"@vow-auth/store-contracts": ["./packages/store-contracts/src/index.ts"],
			"@vow-auth/authorize": ["./packages/authorize/src/index.ts"],
			"@vow-auth/factor-email-link": [
				"./packages/factor-email-link/src/index.ts"
			],
			"@vow-auth/factor-totp": ["./packages/factor-totp/src/index.ts"]
		}
	},
	"include": [
		"vitest.config.ts",
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"examples/*/src/**/*.ts",
		"examples/*/tests/**/*.ts"
	],
	"exclude": ["node_modules", "**/dist"]
}
