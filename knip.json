{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"workspaces": {
		".": {
			"entry": ["scripts/*.mjs"]
		},
		"packages/*": {
			"entry": ["tests/**/*.test.ts"]
		},
		"examples/*": {
			"entry": ["src/server.ts", "tests/**/*.test.ts"]
		},
		"packages/store-contracts": {},
		"packages/test-support": {},
		"packages/doctor": {
			"entry": ["tests/**/*.test.ts", "tests/fixtures/*.ts"]
		},
		"examples/flow-map": {
			"entry": ["app.js", "tests/**/*.test.ts"],
			"ignore": ["build.d.mts"]
		}
	}
}
